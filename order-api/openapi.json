{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Order API"
  },
  "components": {
    "schemas": {
      "OrderResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "order": {
            "type": "object",
            "properties": {
              "orderId": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              }
            },
            "required": [
              "orderId",
              "item",
              "quantity"
            ]
          }
        },
        "required": [
          "message",
          "order"
        ]
      },
      "OrderInput": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "example": "コーヒー豆"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 2
          }
        },
        "required": [
          "item",
          "quantity"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/orders": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "orderCreated": {
                      "$ref": "#/components/schemas/OrderResponse"
                    }
                  },
                  "required": [
                    "message",
                    "orderCreated"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  }
}
{
  "name": "order-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate-proto && npm run build:spec && tsx watch src/index.ts",
    "build": "npm run generate-proto && tsc",
    "build:spec": "tsx scripts/export-openapi.ts",
    "generate-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=esModuleInterop=true -I/infrastructure/schema-registry /infrastructure/schema-registry/*.proto"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.0",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.2",
    "kafkajs": "^2.2.4",
    "ts-proto": "^2.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
